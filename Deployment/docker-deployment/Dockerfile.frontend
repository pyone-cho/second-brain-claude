# =============================================================================
# Stage 1: Build
# =============================================================================
FROM node:18-alpine AS build

WORKDIR /app

# Install all dependencies
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy all source files and build config
COPY frontend/index.html ./
COPY frontend/tsconfig.json frontend/tsconfig.node.json frontend/vite.config.ts \
     frontend/tailwind.config.js frontend/postcss.config.js ./
COPY frontend/src/ ./src/

# Build the production bundle (tsc type-check + vite build)
RUN npm run build

# =============================================================================
# Stage 2: Production
# =============================================================================
FROM nginx:alpine AS prod

# Copy custom nginx configuration (context is project root, so nginx.conf is
# at Deployment/docker-deployment/nginx.conf)
COPY Deployment/docker-deployment/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static assets from build stage
COPY --from=build /app/dist/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
